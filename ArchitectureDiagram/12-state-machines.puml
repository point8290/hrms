@startuml HRMS_State_Machines
title HRMS - Important Business State Machines

state "Payroll Run" as PR {
    [*] --> DRAFT
    DRAFT --> VALIDATING
    VALIDATING --> CALCULATING
    CALCULATING --> CALCULATED
    CALCULATED --> UNDER_REVIEW
    UNDER_REVIEW --> APPROVED
    APPROVED --> FINALIZED
    FINALIZED --> PAYMENT_PENDING
    PAYMENT_PENDING --> PAID
    VALIDATING --> FAILED
    CALCULATING --> FAILED
    FAILED --> RETRY
}

state "Leave Application" as LA {
    [*] --> DRAFT
    DRAFT --> SUBMITTED
    SUBMITTED --> PENDING_APPROVAL
    PENDING_APPROVAL --> APPROVED
    PENDING_APPROVAL --> REJECTED
    APPROVED --> CANCELLED
}

state "Expense Claim" as EC {
    [*] --> DRAFT
    DRAFT --> SUBMITTED
    SUBMITTED --> MANAGER_REVIEW
    MANAGER_REVIEW --> FINANCE_REVIEW
    MANAGER_REVIEW --> REJECTED
    FINANCE_REVIEW --> APPROVED
    FINANCE_REVIEW --> REJECTED
    APPROVED --> PAYMENT_PENDING
    PAYMENT_PENDING --> PAID
}

@enduml
