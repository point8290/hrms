@startuml HRMS_Node_Components
!include <C4/C4_Component.puml>
title HRMS - Node.js API Component Diagram
LAYOUT_WITH_LEGEND()

ContainerDb(db, "PostgreSQL", "Multi-tenant database with RLS")
ContainerQueue(sqs, "AWS SQS", "Domain event queues")
ContainerDb(redis, "Redis", "Cache and distributed locks")
Container(web, "React Web Application", "Employee / Manager / HR UI")

Container_Boundary(api, "Node.js HRMS API") {
    Component(auth, "Authentication", "JWT / Passport", "Authentication, token validation and session management.")
    Component(authorization, "Authorization", "RBAC", "Tenant membership, roles and permissions.")
    Component(tenant, "Tenant Management", "Module", "Tenant configuration and tenant context.")
    Component(coreHr, "Core HR", "Module", "Employee, department, designation, location and employment history.")
    Component(lifecycle, "Employee Lifecycle", "Module", "Onboarding, promotion, transfer, confirmation and separation.")
    Component(workforce, "Workforce Management", "Module", "Shift assignment, attendance requests, regularization and timesheets.")
    Component(leave, "Leave Management", "Module", "Leave policies, applications, allocations and approvals.")
    Component(expense, "Expense Management", "Module", "Expense claims, advances, approvals and reimbursements.")
    Component(compensation, "Compensation", "Module", "Salary components, structures and effective-dated assignments.")
    Component(payroll, "Payroll Orchestrator", "Module", "Creates payroll runs, snapshots inputs, tracks state and coordinates calculation.")
    Component(performance, "Performance", "Module", "Goals, performance cycles and reviews.")
    Component(recruitment, "Recruitment", "Module", "Job requisitions, candidates, applications and offers.")
    Component(document, "Document Management", "Module", "Document metadata and secure S3 access.")
    Component(workflow, "Workflow Engine", "Module", "Configurable approval chains, delegation and escalation.")
    Component(notification, "Notification Orchestrator", "Module", "Notification templates, preferences and delivery requests.")
    Component(audit, "Audit Service", "Module", "Immutable audit records for sensitive business actions.")
    Component(eventPublisher, "Event Publisher", "Infrastructure", "Publishes domain events using an outbox pattern.")
    Component(tenantContext, "Tenant Context Middleware", "Infrastructure", "Resolves tenant_id and establishes database transaction context.")
}

Rel(web, auth, "HTTPS requests")
Rel(auth, authorization, "Authenticated user")
Rel(authorization, tenantContext, "Authorized tenant")
Rel(tenantContext, tenant, "Tenant context")
Rel(tenant, db, "CRUD")
Rel(coreHr, db, "CRUD")
Rel(lifecycle, db, "CRUD")
Rel(workforce, db, "CRUD")
Rel(leave, db, "CRUD")
Rel(expense, db, "CRUD")
Rel(compensation, db, "CRUD")
Rel(performance, db, "CRUD")
Rel(recruitment, db, "CRUD")
Rel(document, db, "Metadata")
Rel(payroll, db, "Payroll state")
Rel(coreHr, lifecycle, "Employee lifecycle")
Rel(workforce, leave, "Attendance / leave impact")
Rel(compensation, payroll, "Compensation inputs")
Rel(leave, payroll, "Leave / LOP inputs")
Rel(workforce, payroll, "Attendance inputs")
Rel(payroll, workflow, "Approval")
Rel(leave, workflow, "Approval")
Rel(expense, workflow, "Approval")
Rel(lifecycle, workflow, "Approval")
Rel(coreHr, eventPublisher, "HR events")
Rel(workforce, eventPublisher, "Attendance events")
Rel(leave, eventPublisher, "Leave events")
Rel(expense, eventPublisher, "Expense events")
Rel(payroll, eventPublisher, "Payroll events")
Rel(eventPublisher, sqs, "Publishes events")
Rel(notification, sqs, "Publishes notification jobs")
Rel(audit, db, "Append audit record")
Rel(notification, db, "Notification state")
Rel(notification, redis, "Cache / rate limit")
@enduml
